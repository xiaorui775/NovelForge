# Database
DB_PASSWORD=your_secure_password_here

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Optional password protection. Leave empty/commented to allow anonymous access.
# When set, the frontend shows a login page and all API endpoints (except health/auth) require a token.
# ADMIN_PASSWORD=change-me

# HMAC signing key for login tokens. MUST be a random string in production;
# the default value in config.py is insecure and leaking it lets anyone forge tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=please-change-this-to-a-random-string

# Allowed CORS origins, comma-separated. Empty = same-origin only.
# Wildcard "*" is disabled for security. Example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

# Backend
DEBUG=true
LOG_LEVEL=INFO

# Cost control (Phase 3.1) — all optional, 0/empty = disabled
# Hard cap on tokens for a single generation (0 = no limit)
MAX_TOKENS_PER_GENERATION=0
# Soft cap in USD for a single generation; exceeding triggers confirmation (0 = no limit)
MAX_COST_PER_GENERATION=0
# If estimated cost exceeds this value, router will try to auto-downgrade to a cheaper model (0 = off)
AUTO_DOWNGRADE_THRESHOLD=0
