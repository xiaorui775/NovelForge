# Database
DB_PASSWORD=your_secure_password_here

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Optional password protection. Leave empty/commented to allow anonymous access.
# When set, the frontend shows a login page and all API endpoints (except health/auth) require a token.
# ADMIN_PASSWORD=change-me

# Allowed CORS origins, comma-separated. Empty = same-origin only.
# Wildcard "*" is disabled for security. Example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=

# Backend
DEBUG=true
LOG_LEVEL=INFO
