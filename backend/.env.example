# Database
DATABASE_URL=postgresql+asyncpg://novelforge:your_secure_password_here@localhost:5432/novelforge

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Backend
DEBUG=true
LOG_LEVEL=INFO

# Optional password protection. Leave commented to allow anonymous access (local dev).
# When set, the frontend shows a login page and all /api/* endpoints (except health/auth) require a token.
# ADMIN_PASSWORD=change-me

# HMAC signing key for login tokens. Random in production; the config.py default
# is insecure and leaking it lets anyone forge tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=please-change-this-to-a-random-string

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000